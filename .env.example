# =========================
# LLM 多厂商接入（OpenAI 兼容端点）
# =========================
# 厂商：zhipuai | deepseek | qwen | moonshot | openai | ollama | custom
# 优先级：LLM_* > ZHIPUAI_*（智谱专属回退）> 厂商预设默认值
# 切换厂商时建议显式设置 LLM_MODEL（各厂商模型名不通用）
LLM_PROVIDER=zhipuai
LLM_API_KEY=your_llm_api_key_here
# LLM_MODEL=glm-5.1
# LLM_BASE_URL=             # 未设置取厂商预设；custom 必填（vLLM / LM Studio 等）
# EMBEDDING_MODEL=          # 语义记忆 embeddings 模型（未设置回退 ZHIPUAI_EMBEDDING_MODEL）

# 智谱AI 专属配置（LLM_* 未设置时的向后兼容回退）
# ZHIPUAI_API_KEY=your_zhipuai_api_key_here
# ZHIPUAI_MODEL=glm-5.1
# ZHIPUAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 高德地图API配置
AMAP_API_KEY=your_amap_api_key_here

# 应用配置
APP_NAME=智能旅行助手
DEBUG=false

# API 访问控制（可选）：设置后所有端点要求 Authorization: Bearer <token>；
# 留空表示不启用鉴权（仅建议本地开发时留空）
# API_AUTH_TOKEN=

# 网络 / 缓存调优（可选，以下为默认值）
# HTTP_TIMEOUT=10          # 高德 API 请求超时（秒）
# HTTP_MAX_RETRIES=3       # 失败重试次数（针对 429 / 5xx 指数退避）
# CACHE_TTL=1800           # POI / 天气等结果缓存有效期（秒）
# CACHE_MAX_SIZE=512       # 进程内缓存最大条目数（FIFO 淘汰）

# LLM / Agent 调优（可选，以下为默认值）
# AGENT_TEMPERATURE=0.7    # 生成多样性
# AGENT_MAX_TOKENS=4096    # 单次回复最大 token
# AGENT_RECURSION_LIMIT=40 # ReAct 循环步数上限
# LLM_TIMEOUT=120          # LLM 请求超时（秒）
# LLM_MAX_RETRIES=2        # LLM 请求失败重试次数

# 可观测性 / 运行时（可选，以下为默认值）
# LOG_LEVEL=INFO           # 日志级别（DEBUG=true 时强制 DEBUG）
# MEMORY_DIR=memory        # 会话记忆存储目录
# MEMORY_BACKEND=file      # 会话记忆后端：file | sqlite
# AGENT_HISTORY_LIMIT=8    # 直传 LLM 的历史消息条数（更早消息压缩为摘要）
# AGENT_HISTORY_CONTENT_MAX=500  # 单条历史内容截断长度

# 行程规划 Plan-and-Execute（可选，以下为默认值）
# PLAN_VERIFY_RETRIES=1    # 结构化草稿未通过校验时的自纠重试次数

# 向量语义记忆（依赖 embeddings API 调用，默认关闭；开启后跨会话召回相关行程）
# SEMANTIC_MEMORY_ENABLED=false
# SEMANTIC_MEMORY_TOP_K=3          # 每轮召回条数
# SEMANTIC_MEMORY_MAX_ENTRIES=500  # 记忆条目上限（FIFO 淘汰）
# ZHIPUAI_EMBEDDING_MODEL=embedding-2
