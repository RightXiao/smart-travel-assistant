# 环境变量 / 密钥（.env.example 为模板，需保留追踪）
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# 虚拟环境
venv/
.venv/
env/

# IDE
.vscode/
.idea/
.cursor/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
.streamlit/secrets.toml

# Claude Code
.claude/

# Trae IDE
.trae/

# 日志（setup_logger 支持可选文件输出）
*.log
logs/

# 测试覆盖率产物
.coverage
.coverage.*
htmlcov/
coverage.xml

# 工具缓存
.ruff_cache/
.mypy_cache/
.pytest_cache/

# 运行时持久化记忆（FileMemory 默认写入目录；SQLiteMemory 同样默认写入其中，
# 但自定义 db_path 时可能落在任意位置，故兜底忽略 SQLite 文件）
memory/
*.db
*.sqlite
*.sqlite3

# 测试临时目录（tmp_path 在当前环境不可用时的替代）
tests/.tmp/

# ZCode 内部工作目录
.zcode/

